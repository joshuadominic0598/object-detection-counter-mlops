# Storage adapter: mongodb (default) or sqlite. `make start` starts this mode.
DATABASE_BACKEND=mongodb
API_PORT=5000
# Bind the local workspace to loopback. Put an authenticated HTTPS proxy in front before sharing.
API_HOST=127.0.0.1

# Host-side MongoDB connection. In Compose the API uses mongo:27017.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=counter

# Host-side SQLite path (direct Python runs). Containers use /data/counter.sqlite3
# in a persistent Docker volume. Run dashboards via make to use that volume.
SQLITE_PATH=tmp/sqlite/counter.sqlite3

# Clear counts and request history in ONLY the selected DB during `make start`.
CLEAR_DATABASE_ON_START=false

# Legacy MongoDB-only reset flag (ignored in SQLite mode).
CLEAR_MONGO_DB=false

# Set to true to clear model_management/model_registry/registry.json's dataset-
# version history and cached performance during `make start` (keeps registered
# models). Useful when switching to a new, unrelated golden dataset/use case.
CLEAR_MODEL_REGISTRY=false

# Optional server key for Roboflow inference; users can supply their own in the UI.
# Also used by existing training/evaluation commands. Never commit a real key.
# Replace dataset settings in model_management/config.py before training.
ROBOFLOW_API_KEY=

# Google Drive OAuth "Desktop app" client (Google Cloud Console -> APIs & Services
# -> Credentials). GOOGLE_DRIVE_FOLDER_ID is optional: the parent folder the
# "Model-training-ObjectCounter" folder is created under (defaults to "My Drive").
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
